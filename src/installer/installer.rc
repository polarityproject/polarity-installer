// Version information for polarity-installer.exe (Properties, Details).
#include <winver.h>

#include "version.h"

VS_VERSION_INFO VERSIONINFO
FILEVERSION POLARITY_INSTALLER_VERSION_NUMBERS
PRODUCTVERSION POLARITY_INSTALLER_VERSION_NUMBERS
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Polarity Installer"
            VALUE "FileVersion", POLARITY_INSTALLER_VERSION
            VALUE "InternalName", "polarity-installer"
            VALUE "OriginalFilename", "polarity-installer.exe"
            VALUE "ProductName", "Polarity"
            VALUE "ProductVersion", POLARITY_INSTALLER_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
